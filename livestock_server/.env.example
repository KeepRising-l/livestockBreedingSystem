# 复制本文件为 .env 后修改对应值

# ===== 应用配置 =====
APP_NAME=智能养殖信息管理系统
APP_ENV=dev                       # dev / prod
APP_HOST=0.0.0.0
APP_PORT=8000

# ===== 数据库配置 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=livestock_db
# 是否打印每条 SQL（调试用）。默认 false：改为 true 会刷屏，且拖慢 Windows 终端输出
DB_ECHO=false

# ===== Redis 配置 =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== JWT 配置 =====
JWT_SECRET_KEY=change-this-to-a-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440   # token 有效期，单位分钟，1440 = 1 天

# ===== 超级管理员初始账号 =====
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=admin123
SUPER_ADMIN_PHONE=13800000000
